PORT=5001
NODE_ENV=development

# ─── MongoDB Atlas ──────────────────────────────────────────────────────────
# Set your MongoDB Atlas connection string here.
# IMPORTANT: Never commit the actual password to Git.
MONGODB_URI=mongodb+srv://<db_username>:<DB_PASSWORD>@cluster0.cqmblsf.mongodb.net/audittrail?appName=Cluster0

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
JWT_EXPIRES=15m

# ─── CORS ───────────────────────────────────────────────────────────────────
# Use comma separation for multiple origins (e.g. http://localhost:5173,http://localhost:5174)
CLIENT_URL=http://localhost:5173

# ─── AI (Optional) ──────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
