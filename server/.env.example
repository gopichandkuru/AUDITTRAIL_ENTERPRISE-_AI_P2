# ─── Server ─────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────
# Atlas (recommended for production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/audittrail
#
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/audittrail
#
# Leave empty to use in-memory DB (auto-seeded on startup):
MONGODB_URI=

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES=15m

# ─── CORS ────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI (optional) ───────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
